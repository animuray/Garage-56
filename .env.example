# Server
PORT=3001
JWT_SECRET=change_me_to_a_random_secret_string

# Frontend URL (used for CORS)
FRONTEND_URL=https://yourdomain.com

# Telegram bot (create via @BotFather). Leave empty to run the API without the bot.
TELEGRAM_BOT_TOKEN=

# Web push: browser notifications about new bookings. Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"   (run inside /server)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=garage56
DB_USER=garage56
DB_PASSWORD=change_me_to_strong_password
